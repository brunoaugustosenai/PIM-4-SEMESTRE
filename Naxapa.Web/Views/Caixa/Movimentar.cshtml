@model CashMovementViewModel
@{ViewData["Title"]="Movimentar caixa";}<div class="page-heading"><div><h1>Movimentar caixa</h1><p class="page-subtitle">Sessão #@Model.CaixaSessaoId</p></div></div><div class="panel form-panel"><form method="post"><input asp-for="CaixaSessaoId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="TipoMovimento">Movimento</label><select asp-for="TipoMovimento"><option value="SUPRIMENTO">Suprimento</option><option value="SANGRIA">Sangria</option><option value="AJUSTE_ENTRADA">Ajuste de entrada</option><option value="AJUSTE_SAIDA">Ajuste de saída</option></select></div><div class="field"><label asp-for="Valor"></label><input asp-for="Valor"/></div><div class="field field-full"><label asp-for="Descricao"></label><textarea asp-for="Descricao"></textarea></div></div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Registrar</button></div></form></div>