@model CashOpenViewModel
@{ViewData["Title"]="Abrir caixa";}<div class="page-heading"><div><h1>Abrir caixa</h1><p class="page-subtitle">O operador autenticado será registrado automaticamente.</p></div></div><div class="panel form-panel"><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="CaixaId">Caixa</label><select asp-for="CaixaId" asp-items="Model.Caixas"><option value="">Selecione</option></select></div><div class="field"><label asp-for="ValorAbertura"></label><input asp-for="ValorAbertura"/></div><div class="field field-full"><label asp-for="Observacao"></label><textarea asp-for="Observacao"></textarea></div></div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Abrir sessão</button></div></form></div>