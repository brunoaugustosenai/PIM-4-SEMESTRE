@model CashIndexViewModel
@{ViewData["Title"]="Caixa";}<section class="page-heading"><div><p class="eyebrow">Financeiro</p><h1>Caixa</h1><p class="page-subtitle">Aberturas, recebimentos, suprimentos, sangrias, conferência e diferenças.</p></div><div class="heading-actions"><a class="button button-secondary" asp-action="Create">Cadastrar caixa</a><a class="button button-primary" asp-action="Abrir">Abrir caixa</a></div></section>
<section class="panel"><div class="panel-header"><h2>Caixas cadastrados</h2></div><div class="table-wrap"><table><thead><tr><th>Código</th><th>Nome</th><th>Descrição</th><th>Situação</th><th>Sessão</th></tr></thead><tbody>@foreach(var c in Model.Caixas){<tr><td>@c.Codigo</td><td>@c.Nome</td><td>@c.Descricao</td><td><span class="badge @(c.Ativo?"success":"danger")">@(c.Ativo?"Ativo":"Inativo")</span></td><td><span class="badge @(c.Aberto?"warning":"neutral")">@(c.Aberto?"Aberto":"Fechado")</span></td></tr>}</tbody></table></div></section>
<section class="panel" style="margin-top:16px"><div class="panel-header"><h2>Sessões recentes</h2></div><div class="table-wrap"><table><thead><tr><th>Caixa</th><th>Operador</th><th>Abertura</th><th>Vendas</th><th>Suprimentos</th><th>Sangrias</th><th>Esperado</th><th>Diferença</th><th></th></tr></thead><tbody>@if(Model.Sessoes.Count==0){<tr><td colspan="9" class="table-empty">Nenhuma sessão de caixa registrada.</td></tr>}@foreach(var s in Model.Sessoes){<tr><td><strong>@s.Caixa</strong><div><span class="badge @(s.Status=="ABERTO"?"warning":"success")">@s.Status</span></div></td><td>@s.Operador</td><td>@s.Abertura.ToString("C")<div class="muted">@s.AbertoEm.ToString("dd/MM HH:mm")</div></td><td>@s.Vendas.ToString("C")</td><td>@s.Suprimentos.ToString("C")</td><td>@s.Sangrias.ToString("C")</td><td>@s.SaldoEsperado.ToString("C")</td><td>@(s.Diferenca?.ToString("C")??"-")</td><td>@if(s.Status=="ABERTO"){<div class="stack"><a class="button button-secondary" asp-action="Movimentar" asp-route-id="@s.Id">Movimentar</a><a class="button button-primary" asp-action="Fechar" asp-route-id="@s.Id">Fechar</a></div>}</td></tr>}</tbody></table></div></section>