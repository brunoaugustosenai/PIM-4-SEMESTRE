@model UserFormViewModel
@{ViewData["Title"]="Editar perfil";}<div class="page-heading"><div><h1>Editar informações</h1><p class="page-subtitle">Atualize seus dados de acesso.</p></div></div><div class="panel form-panel"><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="Nome"></label><input asp-for="Nome"/></div><div class="field"><label asp-for="UserName"></label><input asp-for="UserName"/></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"/></div><div class="field"><label asp-for="Telefone"></label><input asp-for="Telefone"/></div></div><div class="form-actions"><a class="button button-secondary" asp-action="Perfil">Cancelar</a><button class="button button-primary">Salvar</button></div></form></div>