@model ProfileViewModel
@{ ViewData["Title"]="Meu perfil"; }<div class="page-heading"><div><span class="eyebrow">Conta</span><h1>@Model.Nome</h1><p class="page-subtitle">@Model.Perfil · @Model.Estabelecimento</p></div><div class="heading-actions"><a class="button button-secondary" asp-action="EditarPerfil">Editar</a><a class="button button-secondary" asp-action="AlterarSenha">Alterar senha</a></div></div>
<div class="panel form-panel"><div class="detail-grid"><div class="detail-box"><span>Usuário</span><strong>@Model.UserName</strong></div><div class="detail-box"><span>E-mail</span><strong>@Model.Email</strong></div><div class="detail-box"><span>Telefone</span><strong>@(Model.Telefone??"-")</strong></div><div class="detail-box"><span>Perfil</span><strong>@Model.Perfil</strong></div></div>
@if(Model.Estabelecimentos.Count>1){<form asp-action="TrocarEstabelecimento" method="post" class="inline-form" style="margin-top:18px"><div class="field"><label>Estabelecimento ativo</label><select name="estabelecimentoId" asp-items="Model.Estabelecimentos"></select></div><button class="button button-primary">Trocar</button></form>}</div>