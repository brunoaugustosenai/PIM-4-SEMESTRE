@model ChangePasswordViewModel
@{ViewData["Title"]="Alterar senha";}<div class="page-heading"><div><h1>Alterar senha</h1><p class="page-subtitle">A alteração revoga tokens de API existentes.</p></div></div><div class="panel form-panel"><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword"/></div><div></div><div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword"/></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword"/></div></div><div class="form-actions"><a class="button button-secondary" asp-action="Perfil">Cancelar</a><button class="button button-primary">Alterar senha</button></div></form></div>