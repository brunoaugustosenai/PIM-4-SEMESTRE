@inject Naxapa.Web.Security.CurrentUserService CurrentUser
@model IReadOnlyList<MenuRow>
@{ViewData["Title"]="Cardápios";}<section class="page-heading"><div><h1>Cardápios</h1><p class="page-subtitle">Cardápios por estabelecimento e disponibilidade de produtos.</p></div><div class="heading-actions"><a class="button button-secondary" asp-controller="CardapioDigital" asp-action="Index" asp-route-estabelecimentoId="@CurrentUser.EstabelecimentoId" target="_blank">Abrir cardápio digital</a><a class="button button-primary" asp-action="Create">Novo cardápio</a></div></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Produtos</th><th>Período</th><th>Publicado</th><th>Ativo</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Nome</strong></td><td>@x.Produtos</td><td>@(x.Inicio?.ToString("dd/MM/yyyy")??"-") → @(x.Fim?.ToString("dd/MM/yyyy")??"-")</td><td>@(x.Publicado?"Sim":"Não")</td><td>@(x.Ativo?"Sim":"Não")</td><td><div class="inline-form"><a class="button button-secondary" asp-action="Products" asp-route-id="@x.Id">Produtos</a><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a></div></td></tr>}</tbody></table></div></section>