@model MenuProductsViewModel
@{ViewData["Title"]="Produtos do cardápio";}<div class="page-heading"><div><h1>@Model.Cardapio</h1><p class="page-subtitle">Selecione os produtos que ficam disponíveis neste cardápio.</p></div></div><div class="panel form-panel"><form method="post"><input asp-for="CardapioId" type="hidden"/><div class="checkbox-list">@foreach(var p in Model.Produtos){<label class="checkbox-item"><input type="checkbox" name="ProdutoIds" value="@p.ProdutoId" checked="@p.Selecionado"/><span><strong>@p.Nome</strong><br/><span class="muted">@p.Categoria · @p.Preco.ToString("C")</span></span></label>}</div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Salvar vínculos</button></div></form></div>