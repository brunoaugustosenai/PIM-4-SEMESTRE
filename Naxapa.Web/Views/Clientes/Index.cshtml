@model IReadOnlyList<ClientRow>
@{ViewData["Title"]="Clientes";var page=(int)(ViewBag.Page??1);var pages=(int)(ViewBag.TotalPages??1);}<section class="page-heading"><div><p class="eyebrow">Cadastros</p><h1>Clientes</h1><p class="page-subtitle">Dados pessoais protegidos por autorização e separados por estabelecimento.</p></div><a class="button button-primary" asp-action="Create">Novo cliente</a></section><section class="panel"><form class="toolbar inline-form" method="get"><div class="field"><label>Busca</label><input name="q" value="@ViewBag.Query" placeholder="Nome, documento, cidade ou bairro"/></div><div class="field"><label>Situação</label><select name="ativo"><option value="">Todas</option><option value="true" selected="@(ViewBag.Active is true)">Ativos</option><option value="false" selected="@(ViewBag.Active is false)">Inativos</option></select></div><button class="button button-primary">Filtrar</button><span class="toolbar-spacer"></span><span class="muted">@ViewBag.Total registro(s)</span></form><div class="table-wrap"><table><thead><tr><th>Cliente</th><th>Documento</th><th>Telefone</th><th>Cidade</th><th>Bairro</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var i in Model){<tr><td><strong>@i.Nome</strong></td><td>@i.Documento</td><td>@i.Telefone</td><td>@i.Cidade</td><td>@i.Bairro</td><td><span class="badge @(i.Ativo?"success":"danger")">@(i.Ativo?"Ativo":"Inativo")</span></td><td><div class="inline-form"><a class="button button-secondary" asp-action="History" asp-route-id="@i.Id">Histórico</a><a class="button button-secondary" asp-action="Edit" asp-route-id="@i.Id">Editar</a><form asp-action="Toggle" asp-route-id="@i.Id" method="post"><button class="button button-secondary">@(i.Ativo?"Desativar":"Ativar")</button></form></div></td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="table-empty">Nenhum cliente encontrado.</td></tr>}</tbody></table></div>@if(pages>1){<div class="pagination">@for(var n=1;n<=pages;n++){if(n==page){<span class="current">@n</span>}else{<a asp-route-page="@n" asp-route-q="@ViewBag.Query" asp-route-ativo="@ViewBag.Active">@n</a>}}</div>}</section>