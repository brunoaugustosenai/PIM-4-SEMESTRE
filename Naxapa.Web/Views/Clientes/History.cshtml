@model IReadOnlyList<OrderRow>
@{ViewData["Title"]="Histórico do cliente";}<div class="page-heading"><div><h1>@ViewBag.ClientName</h1><p class="page-subtitle">Últimos pedidos vinculados ao cliente.</p></div><a class="button button-secondary" asp-action="Index">Voltar</a></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Tipo</th><th>Status</th><th>Financeiro</th><th>Total</th><th>Data UTC</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.Numero</td><td>@o.Tipo</td><td>@o.Status</td><td>@o.Financeiro</td><td>@o.Total.ToString("C")</td><td>@o.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></section>