@model ClientFormViewModel
@{ ViewData["Title"] = "Editar cliente"; }
<section class="page-heading"><div><p class="eyebrow">Clientes</p><h1>Editar cliente</h1><p class="page-subtitle">As alterações serão persistidas no SQL Server.</p></div></section>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.ClienteId" method="post"><partial name="_Form" model="Model" /><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary" type="submit"><span class="material-symbols-rounded">save</span>Salvar alterações</button></div></form></section>
