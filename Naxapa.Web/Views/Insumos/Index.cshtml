@model IReadOnlyList<InsumoRow>
@{ViewData["Title"]="Insumos";}<section class="page-heading"><div><h1>Insumos</h1><p class="page-subtitle">Base das fichas técnicas e composição dos produtos.</p></div><a class="button button-primary" asp-action="Create">Novo insumo</a></section><section class="panel"><form class="toolbar" method="get"><div class="field"><label>Busca</label><input name="q" value="@ViewBag.Query"/></div><button class="button button-primary">Pesquisar</button></form><div class="table-wrap"><table><thead><tr><th>Código</th><th>Nome</th><th>Unidade</th><th>Custo médio</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Codigo</td><td><strong>@x.Nome</strong></td><td>@x.Unidade</td><td>@(x.CustoMedio?.ToString("C")??"-")</td><td>@(x.Ativo?"Ativo":"Inativo")</td><td><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div></section>