@model IReadOnlyList<SectorRow>
@{ViewData["Title"]="Setores de produção";}<section class="page-heading"><div><h1>Setores de produção</h1><p class="page-subtitle">Cozinha, bar, pizzaria, expedição e demais destinos operacionais.</p></div><a class="button button-primary" asp-action="Create">Novo setor</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Setor</th><th>Descrição</th><th>Produtos</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Nome</strong></td><td>@x.Descricao</td><td>@x.Produtos</td><td><span class="badge @(x.Ativo?"success":"danger")">@(x.Ativo?"Ativo":"Inativo")</span></td><td><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div></section>