@model IReadOnlyList<RecipeRow>
@{ViewData["Title"]="Fichas técnicas";}<section class="page-heading"><div><h1>Fichas técnicas</h1><p class="page-subtitle">Composição de produtos por insumos e rendimento.</p></div><a class="button button-primary" asp-action="Create">Nova ficha técnica</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Rendimento</th><th>Itens</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Produto</strong></td><td>@x.Rendimento</td><td>@x.Itens</td><td>@(x.Ativo?"Ativa":"Inativa")</td><td><div class="inline-form"><a class="button button-secondary" asp-action="Items" asp-route-id="@x.Id">Composição</a><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a></div></td></tr>}</tbody></table></div></section>