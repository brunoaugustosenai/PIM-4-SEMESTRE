@model IReadOnlyList<RecipeItemRow>
@{ViewData["Title"]="Composição";}<section class="page-heading"><div><h1>@ViewBag.Product</h1><p class="page-subtitle">Rendimento: @ViewBag.Rendimento · Custo calculado: @(((decimal)ViewBag.TotalCost).ToString("C"))</p></div><a class="button button-primary" asp-action="AddItem" asp-route-id="@ViewBag.RecipeId">Adicionar insumo</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Insumo</th><th>Quantidade</th><th>Unidade</th><th>Custo unitário</th><th>Custo item</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Insumo</td><td>@x.Quantidade</td><td>@x.Unidade</td><td>@(x.CustoUnitario?.ToString("C")??"-")</td><td>@(x.CustoItem?.ToString("C")??"-")</td><td><form asp-action="RemoveItem" asp-route-id="@x.Id" method="post"><button class="button button-secondary">Remover</button></form></td></tr>}</tbody></table></div></section>