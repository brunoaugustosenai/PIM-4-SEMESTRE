@model RecipeItemFormViewModel
@{ViewData["Title"]="Adicionar insumo";}<div class="page-heading"><h1>Adicionar insumo</h1></div><div class="panel form-panel"><form method="post"><input asp-for="ReceitaId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="InsumoId">Insumo</label><select asp-for="InsumoId" asp-items="Model.Insumos"><option value="">Selecione</option></select></div><div class="field"><label asp-for="Quantidade"></label><input asp-for="Quantidade" type="number" step="0.0001"/></div><div class="field field-full"><label asp-for="Observacao"></label><textarea asp-for="Observacao"></textarea></div></div><div class="form-actions"><a class="button button-secondary" asp-action="Items" asp-route-id="@Model.ReceitaId">Cancelar</a><button class="button button-primary">Adicionar</button></div></form></div>