@model IReadOnlyList<ProductRow>
@{ViewData["Title"]="Produtos";var page=(int)(ViewBag.Page??1);var pages=(int)(ViewBag.TotalPages??1);var cats=ViewBag.Categories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>??[];}
<section class="page-heading"><div><p class="eyebrow">Cadastros</p><h1>Produtos</h1><p class="page-subtitle">Produtos reais do estabelecimento, com categoria, setor, imagem, preço e disponibilidade.</p></div><div class="heading-actions"><a class="button button-secondary" asp-action="Import">Importar CSV</a><a class="button button-primary" asp-action="Create">Novo produto</a></div></section>
<section class="panel"><form class="toolbar inline-form" method="get"><div class="field"><label>Busca</label><input name="q" value="@ViewBag.Query" placeholder="Nome, código, barras ou categoria"/></div><div class="field"><label>Categoria</label><select name="categoriaId"><option value="">Todas</option>@foreach(var c in cats){<option value="@c.Value" selected="@c.Selected">@c.Text</option>}</select></div><div class="field"><label>Situação</label><select name="ativo"><option value="">Todas</option><option value="true" selected="@(ViewBag.Active is true)">Ativos</option><option value="false" selected="@(ViewBag.Active is false)">Inativos</option></select></div><button class="button button-primary">Filtrar</button><span class="toolbar-spacer"></span><span class="muted">@ViewBag.Total registro(s)</span></form><div class="table-wrap"><table><thead><tr><th>Código</th><th>Produto</th><th>Categoria</th><th>Setor</th><th>Preço</th><th>Cardápio</th><th>Situação</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="8" class="table-empty">Nenhum produto encontrado.</td></tr>}@foreach(var i in Model){<tr><td>@i.Codigo</td><td><strong>@i.Nome</strong></td><td>@i.Categoria</td><td>@i.Setor</td><td>@i.Preco.ToString("C")</td><td><span class="badge @(i.Disponivel?"success":"neutral")">@(i.Disponivel?"Disponível":"Oculto")</span></td><td><span class="badge @(i.Ativo?"success":"danger")">@(i.Ativo?"Ativo":"Inativo")</span></td><td><div class="inline-form"><a class="button button-secondary" asp-action="Edit" asp-route-id="@i.Id">Editar</a><form asp-action="Toggle" asp-route-id="@i.Id" method="post"><button class="button button-secondary">@(i.Ativo?"Desativar":"Ativar")</button></form></div></td></tr>}</tbody></table></div>@if(pages>1){<div class="pagination">@for(var n=1;n<=pages;n++){if(n==page){<span class="current">@n</span>}else{<a asp-route-page="@n" asp-route-q="@ViewBag.Query" asp-route-categoriaId="@ViewBag.CategoryId" asp-route-ativo="@ViewBag.Active">@n</a>}}</div>}</section>