@model ProductImportViewModel
@{ViewData["Title"]="Importar produtos";}<div class="page-heading"><div><h1>Importar produtos por CSV</h1><p class="page-subtitle">O arquivo é validado e pré-visualizado antes de qualquer gravação.</p></div></div><div class="panel form-panel">@if(string.IsNullOrWhiteSpace(Model.ImportToken)){<form method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Arquivo"></label><input asp-for="Arquivo" type="file" accept=".csv"/></div><div class="warning-box" style="margin-top:15px">Cabeçalhos aceitos: Codigo, CodigoBarras, Nome, Categoria, Preco, Setor, Unidade, Descricao.</div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Validar arquivo</button></div></form>}else{<div class="table-wrap"><table><thead><tr><th>Linha</th><th>Código</th><th>Nome</th><th>Categoria</th><th>Preço</th><th>Setor</th><th>Validação</th></tr></thead><tbody>@foreach(var x in Model.Preview){<tr><td>@x.Linha</td><td>@x.Codigo</td><td>@x.Nome</td><td>@x.Categoria</td><td>@x.Preco?.ToString("C")</td><td>@x.Setor</td><td><span class="badge @(x.Valido?"success":"danger")">@(x.Valido?"OK":x.Erro)</span></td></tr>}</tbody></table></div><form asp-action="CommitImport" method="post"><input type="hidden" name="importToken" value="@Model.ImportToken"/><div class="form-actions"><a class="button button-secondary" asp-action="Import">Cancelar</a><button class="button button-primary" disabled="@(Model.Preview.Any(x=>!x.Valido))">Importar @Model.Preview.Count produto(s)</button></div></form>}</div>