@model IReadOnlyList<CategoryRow>
@{ViewData["Title"]="Categorias";}<section class="page-heading"><div><h1>Categorias</h1><p class="page-subtitle">Organização e ordem do cardápio.</p></div><a class="button button-primary" asp-action="Create">Nova categoria</a></section><section class="category-grid">@foreach(var x in Model){<article class="category-card"><div class="category-icon">☷</div><div><strong>@x.Nome</strong><span>@x.Produtos produto(s) · ordem @x.Ordem</span></div><div class="stack"><span class="badge @(x.Ativo?"success":"danger")">@(x.Ativo?"Ativa":"Inativa")</span><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a><form asp-action="Toggle" asp-route-id="@x.Id" method="post"><button class="button button-secondary">@(x.Ativo?"Desativar":"Ativar")</button></form></div></article>}</section>