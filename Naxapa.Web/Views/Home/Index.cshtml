@model DashboardViewModel
@{ ViewData["Title"]="Dashboard"; var maxRevenue=Model.RevenueChart.Count==0?1m:Math.Max(1m,Model.RevenueChart.Max(x=>x.Value)); var maxPayment=Model.PaymentMethods.Count==0?1m:Math.Max(1m,Model.PaymentMethods.Max(x=>x.Valor)); }
<section class="page-heading"><div><p class="eyebrow">Visão geral</p><h1>@Model.Estabelecimento</h1><p class="page-subtitle">Indicadores reais do NaxapaDB · @Model.PeriodoLabel.</p></div></section>
<form method="get" class="panel toolbar inline-form" style="margin-bottom:18px"><div class="field"><label>Período</label><select name="periodo"><option value="hoje" selected="@(Model.Periodo=="hoje")">Hoje</option><option value="ontem" selected="@(Model.Periodo=="ontem")">Ontem</option><option value="7dias" selected="@(Model.Periodo=="7dias")">Últimos 7 dias</option><option value="mes" selected="@(Model.Periodo=="mes")">Mês atual</option><option value="personalizado" selected="@(Model.Periodo=="personalizado")">Personalizado</option></select></div><div class="field"><label>Inicial</label><input type="date" name="dataInicial" value="@Model.DataInicial.ToString("yyyy-MM-dd")"/></div><div class="field"><label>Final</label><input type="date" name="dataFinal" value="@Model.DataFinal.ToString("yyyy-MM-dd")"/></div><button class="button button-primary">Aplicar</button></form>
<section class="metric-grid">@foreach(var m in Model.Metrics){<article class="metric-card"><div class="metric-icon">@m.Icon</div><div class="metric-copy"><span>@m.Label</span><strong>@m.Value</strong><small>@m.Hint</small></div></article>}</section>
<section class="dashboard-grid"><article class="panel panel-large"><div class="panel-header"><div><p class="eyebrow">Faturamento</p><h2>Evolução no período</h2></div></div><div class="kpi-list">@if(Model.RevenueChart.Count==0){<p class="muted">Sem vendas finalizadas no período.</p>}@foreach(var p in Model.RevenueChart){var pct=(double)(p.Value/maxRevenue*100m);<div class="kpi-row"><span>@p.Label</span><div class="kpi-bar"><i style="width:@pct.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></i></div><strong>@p.Value.ToString("C")</strong></div>}</div></article>
<article class="panel"><div class="panel-header"><div><p class="eyebrow">Pagamentos</p><h2>Formas de pagamento</h2></div></div><div class="kpi-list">@if(Model.PaymentMethods.Count==0){<p class="muted">Sem pagamentos confirmados.</p>}@foreach(var p in Model.PaymentMethods){var pct=(double)(p.Valor/maxPayment*100m);<div class="kpi-row"><span>@p.Forma</span><div class="kpi-bar"><i style="width:@pct.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></i></div><strong>@p.Valor.ToString("C")</strong></div>}</div></article></section>
<section class="dashboard-grid" style="margin-top:18px"><article class="panel panel-large"><div class="panel-header"><div><p class="eyebrow">Operação</p><h2>Pedidos recentes</h2></div><a class="text-link" asp-controller="Pedidos" asp-action="Index">Ver todos</a></div><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Status</th><th>Financeiro</th><th>Total</th><th>Horário</th></tr></thead><tbody>@if(Model.RecentOrders.Count==0){<tr><td colspan="6" class="table-empty">Nenhum pedido registrado.</td></tr>}@foreach(var o in Model.RecentOrders){<tr><td>#@o.Numero</td><td>@o.Cliente</td><td><span class="badge @Badge(o.Status)">@Text(o.Status)</span></td><td><span class="badge @Badge(o.Financeiro)">@Text(o.Financeiro)</span></td><td>@o.Total.ToString("C")</td><td>@o.CriadoEm.ToString("dd/MM HH:mm")</td></tr>}</tbody></table></div></article>
<article class="panel"><div class="panel-header"><div><p class="eyebrow">Produtos</p><h2>Mais vendidos</h2></div></div><div class="product-mini-list">@if(Model.TopProducts.Count==0){<p class="muted">Sem vendas para ranquear.</p>}@foreach(var p in Model.TopProducts){<div class="product-mini"><div class="product-avatar">@p.Nome[..1]</div><div class="product-mini-copy"><strong>@p.Nome</strong><span>@p.Categoria</span></div><strong>@p.Preco.ToString("C")</strong></div>}</div></article></section>
<section class="dashboard-grid" style="margin-top:18px"><article class="panel"><div class="panel-header"><div><p class="eyebrow">Categorias</p><h2>Vendas por categoria</h2></div></div><div class="table-wrap"><table><thead><tr><th>Categoria</th><th>Qtd.</th><th>Valor</th></tr></thead><tbody>@foreach(var c in Model.Categories){<tr><td>@c.Categoria</td><td>@c.Quantidade.ToString("0.###")</td><td>@c.Valor.ToString("C")</td></tr>}</tbody></table></div></article><article class="panel"><div class="panel-header"><div><p class="eyebrow">Equipe</p><h2>Vendas por operador</h2></div></div><div class="table-wrap"><table><thead><tr><th>Operador</th><th>Pedidos</th><th>Valor</th></tr></thead><tbody>@foreach(var o in Model.Operators){<tr><td>@o.Operador</td><td>@o.Pedidos</td><td>@o.Valor.ToString("C")</td></tr>}</tbody></table></div></article></section>
@functions{string Badge(string s)=>s switch{"FINALIZADO" or "PAGO" or "PRONTO"=>"success","CANCELADO"=>"danger","EM_PREPARACAO" or "PENDENTE"=>"warning",_=>"neutral"};string Text(string s)=>System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s.Replace("_"," ").ToLowerInvariant());}