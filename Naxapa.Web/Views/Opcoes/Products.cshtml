@model OptionGroupProductsViewModel
@{ViewData["Title"]="Produtos do grupo";}<div class="page-heading"><div><h1>@Model.Grupo</h1><p class="page-subtitle">Defina em quais produtos este grupo de opções poderá ser usado.</p></div></div><div class="panel form-panel"><form method="post"><input asp-for="GrupoOpcaoId" type="hidden"/><div class="checkbox-list">@foreach(var p in Model.Produtos){<label class="checkbox-item"><input type="checkbox" name="ProdutoIds" value="@p.Value" checked="@p.Selected"/> @p.Text</label>}</div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Salvar vínculos</button></div></form></div>