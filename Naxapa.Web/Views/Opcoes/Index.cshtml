@model IReadOnlyList<OptionGroupRow>
@{ViewData["Title"]="Opções e adicionais";var options=ViewBag.Options as IReadOnlyList<OptionRow>??Array.Empty<OptionRow>();}<section class="page-heading"><div><h1>Opções e adicionais</h1><p class="page-subtitle">Regras de seleção são validadas também no backend e no banco.</p></div><a class="button button-primary" asp-action="CreateGroup">Novo grupo</a></section>@foreach(var g in Model){<section class="panel" style="margin-bottom:16px"><div class="panel-header"><div><h2>@g.Nome</h2><p class="muted">@(g.Tipo=="U"?"Seleção única":"Múltipla") · mínimo @g.Minimo · máximo @g.Maximo · @(g.Obrigatorio?"obrigatório":"opcional")</p></div><div class="heading-actions"><a class="button button-secondary" asp-action="Products" asp-route-id="@g.Id">Produtos</a><a class="button button-secondary" asp-action="EditGroup" asp-route-id="@g.Id">Editar grupo</a><a class="button button-primary" asp-action="CreateOption" asp-route-groupId="@g.Id">Nova opção</a></div></div><div class="table-wrap"><table><thead><tr><th>Opção</th><th>Adicional</th><th>Ordem</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var o in options.Where(x=>x.GrupoId==g.Id)){<tr><td>@o.Nome</td><td>@o.Valor.ToString("C")</td><td>@o.Ordem</td><td>@(o.Ativo?"Ativa":"Inativa")</td><td><a class="button button-secondary" asp-action="EditOption" asp-route-id="@o.Id">Editar</a></td></tr>}</tbody></table></div></section>}