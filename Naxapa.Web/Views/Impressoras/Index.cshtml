@model IReadOnlyList<PrinterRow>
@{ViewData["Title"]="Impressoras";}<section class="page-heading"><div><h1>Impressoras</h1><p class="page-subtitle">O navegador apenas enfileira trabalhos. Um agente local é responsável por confirmar a impressão física.</p></div><a class="button button-primary" asp-action="Create">Nova impressora</a><a class="button button-secondary" asp-action="History">Histórico de impressão</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Modelo</th><th>Conexão</th><th>Destino</th><th>Setor</th><th>Padrão</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Nome</strong></td><td>@x.Modelo</td><td>@x.Conexao</td><td>@x.Destino</td><td>@x.Setor</td><td>@(x.Padrao?"Sim":"Não")</td><td><span class="badge @(x.Ativo?"success":"danger")">@(x.Ativo?"Ativa":"Inativa")</span></td><td><div class="inline-form"><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a><form asp-action="Test" asp-route-id="@x.Id" method="post"><button class="button button-secondary">Enfileirar teste</button></form></div></td></tr>}</tbody></table></div></section>