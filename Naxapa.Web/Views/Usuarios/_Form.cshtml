@model UserFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="Nome"></label><input asp-for="Nome"/></div><div class="field"><label asp-for="UserName"></label><input asp-for="UserName" autocomplete="username"/></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"/></div><div class="field"><label asp-for="Telefone"></label><input asp-for="Telefone"/></div>@if(Model.UsuarioId is null){<div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password"/></div>}<div class="field"><label asp-for="PerfilId"></label><select asp-for="PerfilId" asp-items="Model.Perfis"><option value="">Selecione</option></select></div></div><label class="check-field"><input asp-for="Ativo"/> Usuário ativo</label>