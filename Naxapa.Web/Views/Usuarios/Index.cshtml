@model IReadOnlyList<UserRow>
@{ViewData["Title"]="Usuários";}<section class="page-heading"><div><h1>Usuários</h1><p class="page-subtitle">Perfis, acesso ao estabelecimento e último acesso.</p></div><a class="button button-primary" asp-action="Create">Novo usuário</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Usuário</th><th>E-mail</th><th>Perfil</th><th>Último acesso</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Nome</strong></td><td>@x.UserName</td><td>@x.Email</td><td>@(string.IsNullOrWhiteSpace(x.Perfil)?"Sem perfil local":x.Perfil)</td><td>@(x.UltimoAcesso?.ToString("dd/MM/yyyy HH:mm")??"-")</td><td><span class="badge @(x.Ativo?"success":"danger")">@(x.Ativo?"Ativo":"Inativo")</span></td><td><div class="inline-form"><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a><a class="button button-secondary" asp-action="ResetPassword" asp-route-id="@x.Id">Redefinir senha</a></div></td></tr>}</tbody></table></div></section>