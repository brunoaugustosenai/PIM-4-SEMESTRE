@model ResetPasswordViewModel
@{ViewData["Title"]="Redefinir senha";}<div class="page-heading"><div><h1>Redefinir senha</h1><p class="page-subtitle">@Model.Usuario</p></div></div><div class="panel form-panel"><form method="post"><input asp-for="UsuarioId" type="hidden"/><input asp-for="Usuario" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword"/></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword"/></div></div><div class="warning-box">Tokens de API existentes deste usuário serão revogados.</div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary">Redefinir</button></div></form></div>