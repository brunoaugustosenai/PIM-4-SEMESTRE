@model IReadOnlyList<EstablishmentRow>
@{ViewData["Title"]="Estabelecimentos";}<section class="page-heading"><div><p class="eyebrow">Administração</p><h1>Estabelecimentos</h1><p class="page-subtitle">Isolamento de dados por estabelecimento e seleção do contexto ativo.</p></div><a class="button button-primary" asp-action="Create">Novo estabelecimento</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Código</th><th>Nome</th><th>Documento</th><th>Cidade</th><th>UF</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Codigo</td><td><strong>@x.Nome</strong></td><td>@x.Documento</td><td>@x.Cidade</td><td>@x.UF</td><td><span class="badge @(x.Ativo?"success":"danger")">@(x.Ativo?"Ativo":"Inativo")</span></td><td><a class="button button-secondary" asp-action="Edit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div></section>