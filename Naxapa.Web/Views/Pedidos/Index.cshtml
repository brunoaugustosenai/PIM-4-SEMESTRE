@model OrderIndexViewModel
@{ViewData["Title"]="Pedidos";}<section class="page-heading"><div><p class="eyebrow">Operação</p><h1>Pedidos</h1><p class="page-subtitle">Pesquisa, status, período e histórico persistidos no SQL Server.</p></div></section>
<form method="get" class="panel toolbar inline-form"><div class="field"><label>Busca</label><input name="q" value="@Model.Pesquisa" placeholder="Número ou cliente"/></div><div class="field"><label>Status</label><select name="status"><option value="">Todos</option>@foreach(var s in new[]{"NOVO","PENDENTE","EM_PREPARACAO","PRONTO","FINALIZADO","CANCELADO"}){<option value="@s" selected="@(Model.Status==s)">@s.Replace("_"," ")</option>}</select></div><div class="field"><label>Inicial</label><input type="date" name="dataInicial" value="@Model.DataInicial?.ToString("yyyy-MM-dd")"/></div><div class="field"><label>Final</label><input type="date" name="dataFinal" value="@Model.DataFinal?.ToString("yyyy-MM-dd")"/></div><button class="button button-primary">Filtrar</button></form>
<section class="panel" style="margin-top:16px"><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Atendimento</th><th>Status</th><th>Financeiro</th><th>Operador</th><th>Total</th><th>Data</th><th></th></tr></thead><tbody>@if(Model.Pedidos.Count==0){<tr><td colspan="9" class="table-empty">Nenhum pedido encontrado.</td></tr>}@foreach(var p in Model.Pedidos){<tr><td><strong>#@p.Numero</strong></td><td>@p.Cliente</td><td>@p.Tipo</td><td><span class="badge @Badge(p.Status)">@p.Status.Replace("_"," ")</span></td><td>@p.Financeiro</td><td>@p.Operador</td><td>@p.Total.ToString("C")</td><td>@p.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td><td><a class="button button-secondary" asp-action="Details" asp-route-id="@p.PedidoId">Detalhes</a></td></tr>}</tbody></table></div>@if(Model.TotalPaginas>1){<div class="pagination">@for(var i=1;i<=Model.TotalPaginas;i++){if(i==Model.Pagina){<span class="current">@i</span>}else{<a asp-route-pagina="@i" asp-route-status="@Model.Status" asp-route-q="@Model.Pesquisa" asp-route-dataInicial="@Model.DataInicial?.ToString("yyyy-MM-dd")" asp-route-dataFinal="@Model.DataFinal?.ToString("yyyy-MM-dd")">@i</a>}}</div>}</section>
@functions{string Badge(string s)=>s switch{"FINALIZADO" or "PRONTO"=>"success","CANCELADO"=>"danger","PENDENTE" or "EM_PREPARACAO"=>"warning",_=>"neutral"};}