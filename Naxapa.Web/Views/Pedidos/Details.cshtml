@model OrderDetailViewModel
@{ViewData["Title"]=$"Pedido #{Model.Numero}";}<section class="page-heading"><div><p class="eyebrow">Pedido</p><h1>#@Model.Numero · @Model.Cliente</h1><p class="page-subtitle">@Model.TipoAtendimento · @Model.CriadoEm.ToString("dd/MM/yyyy HH:mm") · @Model.Operador</p></div><div class="heading-actions"><a class="button button-secondary" asp-action="Index">Voltar</a></div></section>
<div class="detail-grid"><div class="detail-box"><span>Status</span><strong>@Model.StatusOperacional.Replace("_"," ")</strong></div><div class="detail-box"><span>Financeiro</span><strong>@Model.StatusFinanceiro</strong></div><div class="detail-box"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div><div class="detail-box"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div></div>
<section class="panel" style="margin-top:16px"><div class="panel-header"><h2>Itens</h2></div><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Qtd.</th><th>Unitário</th><th>Opções</th><th>Total</th></tr></thead><tbody>@foreach(var i in Model.Itens){<tr><td><strong>@i.Produto</strong>@if(!string.IsNullOrWhiteSpace(i.Observacao)){<div class="muted">@i.Observacao</div>}@foreach(var o in i.Opcoes){<div class="muted">+ @o.Quantidade x @o.Nome (@o.Total.ToString("C"))</div>}</td><td>@i.Quantidade</td><td>@i.ValorUnitario.ToString("C")</td><td>@i.ValorOpcoes.ToString("C")</td><td>@i.Total.ToString("C")</td></tr>}</tbody></table></div></section>
@if(Model.StatusOperacional is not ("FINALIZADO" or "CANCELADO")){<section class="panel form-panel" style="margin-top:16px"><h2>Atualizar status</h2><form asp-action="AlterarStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@Model.PedidoId"/><div class="field"><label>Novo status</label><select name="novoStatus">@foreach(var s in Next(Model.StatusOperacional)){<option value="@s">@s.Replace("_"," ")</option>}</select></div><div class="field"><label>Observação</label><input name="observacao" maxlength="500"/></div><button class="button button-primary">Atualizar</button></form></section>}
<section class="panel" style="margin-top:16px"><div class="panel-header"><h2>Histórico</h2></div><div class="table-wrap"><table><thead><tr><th>Data</th><th>Anterior</th><th>Novo</th><th>Usuário</th><th>Observação</th></tr></thead><tbody>@foreach(var h in Model.Historico){<tr><td>@h.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td><td>@(h.Anterior??"-")</td><td>@h.Novo</td><td>@h.Usuario</td><td>@(h.Observacao??"-")</td></tr>}</tbody></table></div></section>
@functions{IReadOnlyList<string> Next(string s)=>s switch{"NOVO"=>new[]{"PENDENTE","CANCELADO"},"PENDENTE"=>new[]{"EM_PREPARACAO","CANCELADO"},"EM_PREPARACAO"=>new[]{"PRONTO","CANCELADO"},"PRONTO"=>new[]{"FINALIZADO","CANCELADO"},_=>Array.Empty<string>()};}