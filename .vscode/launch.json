{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NAXAPA Gestão/API (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "NAXAPA: Build Web/API",
      "program": "${workspaceFolder}/Naxapa.Web/bin/Debug/net10.0/Naxapa.Web.dll",
      "cwd": "${workspaceFolder}/Naxapa.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5180"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5180"
      }
    },
    {
      "name": "NAXAPA PDV (.NET 10/WPF)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "NAXAPA: Restore .NET",
      "program": "${workspaceFolder}/Naxapa.Pdv/bin/Debug/net10.0-windows/Naxapa.Pdv.dll",
      "cwd": "${workspaceFolder}/Naxapa.Pdv"
    },
    {
      "name": "NAXAPA Mobile (Flutter)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/Naxapa.Mobile",
      "program": "lib/main.dart"
    }
  ]
}
