<Window x:Class="Naxapa.Pdv.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagamento" Width="430" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="OrderText" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Forma de pagamento" Margin="0,18,0,0"/>
        <ComboBox x:Name="MethodBox" DisplayMemberPath="Name"/>
        <TextBlock Text="Valor" Margin="0,12,0,0"/>
        <TextBox x:Name="ValueBox"/>
        <TextBlock Text="Valor recebido (dinheiro)"/>
        <TextBox x:Name="ReceivedBox"/>
        <TextBlock Text="Sessão de caixa (opcional para cartão/PIX)"/>
        <TextBox x:Name="CashSessionBox"/>
        <TextBlock x:Name="StatusText" Foreground="#DC2626" TextWrapping="Wrap"/>
        <Button Content="Confirmar pagamento" Background="#10B981" Foreground="White" BorderThickness="0" Click="Confirm_Click"/>
    </StackPanel>
</Window>
