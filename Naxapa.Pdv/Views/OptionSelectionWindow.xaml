<Window x:Class="Naxapa.Pdv.Views.OptionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizar produto" Width="650" Height="680" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="ProductName" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="ProductDescription" Foreground="#6B7280" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button Content="Adicionar ao pedido" Height="42" Background="#10B981" Foreground="White" BorderThickness="0" Click="Confirm_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
