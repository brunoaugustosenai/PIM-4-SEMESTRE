<Window x:Class="Naxapa.Pdv.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAXAPA PDV" Width="1280" Height="800" WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F3F4F6">
        <Border DockPanel.Dock="Top" Background="#111827" Padding="18,12">
            <DockPanel>
                <TextBlock Text="NAXAPA PDV" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SessionText" DockPanel.Dock="Right" Foreground="#D1D5DB" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="12" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Novo pedido">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBox x:Name="ProductSearch" Width="320" Margin="0,0,8,8" TextChanged="ProductSearch_TextChanged"/>
                            <Button Content="Atualizar" Click="RefreshProducts_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="ProductsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="170"/>
                                <DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat=C}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Pedido atual" FontSize="20" FontWeight="Bold"/>
                            <ComboBox x:Name="ServiceTypeBox" Margin="0,8" SelectedIndex="0">
                                <ComboBoxItem Content="BALCAO"/><ComboBoxItem Content="VENDA_AVULSA"/><ComboBoxItem Content="MESA"/><ComboBoxItem Content="COMANDA"/>
                            </ComboBox>
                            <TextBox x:Name="ReferenceIdBox" ToolTip="ID da mesa ou comanda quando aplicável"/>
                        </StackPanel>
                        <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Product.Name}" Width="*"/>
                                <DataGridTextColumn Header="Opções" Binding="{Binding OptionsText}" Width="190"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock x:Name="CartTotal" Text="Total: R$ 0,00" FontSize="22" FontWeight="Bold" Margin="0,12"/>
                            <Button Content="Salvar e enviar pedido" Background="#10B981" Foreground="White" BorderThickness="0" Click="SubmitOrder_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Pedidos">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <ComboBox x:Name="StatusFilter" Width="190" SelectedIndex="0"><ComboBoxItem Content=""/><ComboBoxItem Content="NOVO"/><ComboBoxItem Content="PENDENTE"/><ComboBoxItem Content="EM_PREPARACAO"/><ComboBoxItem Content="PRONTO"/><ComboBoxItem Content="FINALIZADO"/></ComboBox>
                        <Button Content="Atualizar" Click="RefreshOrders_Click"/>
                        <Button Content="Avançar status" Click="AdvanceStatus_Click"/>
                        <Button Content="Pagamento" Click="Payment_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="90"/>
                            <DataGridTextColumn Header="Operacional" Binding="{Binding Status}" Width="150"/>
                            <DataGridTextColumn Header="Financeiro" Binding="{Binding FinancialStatus}" Width="130"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="110"/>
                            <DataGridTextColumn Header="Criado" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Mesas e comandas">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="TabCodeBox" Width="150" ToolTip="Código da comanda"/>
                        <Button Content="Abrir comanda" Click="OpenTab_Click"/>
                        <Button Content="Fechar selecionada" Click="CloseTab_Click"/>
                        <Button Content="Atualizar" Click="RefreshTablesTabs_Click"/>
                    </StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="TablesGrid" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,6,0"/>
                        <DataGrid x:Name="TabsGrid" Grid.Column="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="6,0,0,0"/>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Caixa">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <WrapPanel>
                            <ComboBox x:Name="CashRegisterBox" Width="220" DisplayMemberPath="Name"/>
                            <TextBox x:Name="CashValueBox" Width="130" ToolTip="Valor"/>
                            <Button Content="Abrir caixa" Click="OpenCash_Click"/>
                            <Button Content="Suprimento" Click="SupplyCash_Click"/>
                            <Button Content="Sangria" Click="WithdrawCash_Click"/>
                            <Button Content="Fechar caixa" Click="CloseCash_Click"/>
                            <Button Content="Atualizar" Click="RefreshCash_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Para suprimento, sangria e fechamento, selecione uma sessão ABERTA na grade e informe o valor." Foreground="#6B7280"/>
                    </StackPanel>
                    <DataGrid x:Name="CashGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
        <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="GlobalStatus" Text="Pronto"/></StatusBar>
    </DockPanel>
</Window>
